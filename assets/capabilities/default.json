{
  "identifier": "default",
  "windows": ["main"],
  "commands": [
    "t2h:env",
    "t2h:quit",
    "t2h:ui_report",
    "t2h:scan",
    "t2h:deps",
    "t2h:port",
    "t2h:revert",
    "t2h:decisions",
    "t2h:diagnose",
    "t2h:build",
    "t2h:hap",
    "t2h:sign",
    "t2h:deploy",
    "t2h:verify",
    "t2h:cjh_status",
    "t2h:cjh_deploy",
    "t2h:cjh_start",
    "t2h:cjh_models",
    "t2h:cjh_settings",
    "t2h:cjh_settings_save",
    "ws:connect",
    "ws:send",
    "ws:close",
    "log:path",
    "log:write",
    "system:version",
    "system:ping",
    "system:echo"
  ],
  "events": ["ws:frame", "ws:state"],
  "permissions": ["ws:default"],
  "scopes": {
    "ws": {
      "allow": ["127.0.0.1", "localhost"]
    }
  }
}
