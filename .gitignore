# 构建产物（工程根 + 各骨架）
target/
cjpm.lock

# 每端派生骨架 targets/<端>/ 由 `cj-tauri sync` 从 cj-tauri.toml 生成，
# 内含本机绝对路径（框架 / stdx 的 path 依赖），换机器即失效，一律不入库。
# 克隆后先跑一次 `cj-tauri sync`，再用 `cj-tauri check` 比对是否漂移。
# 其下的 target/ 构建产物、鸿蒙的 .buildlog/ 与本地 stdx 软链自然一并忽略。
targets/

# 前端（Vite 模板）
assets/ui/node_modules/
assets/ui/dist/
assets/ui/dev-server.log

# 平台动态库 / 对象文件
*.o
*.so
*.dll
*.dll.a

# 例外：内置 cjh 引擎的随行 DLL 必须入库——它是运行时依赖，不是构建产物。
# 少了它们的症状很隐蔽：窗口照起、http 照通，只有 https（LLM 调用）全灭。
!vendor/cjh/win-x64/*.dll

# 系统文件
.DS_Store
Thumbs.db

# 本地运行产物（scripts/run-dev.sh / .bat 生成）
.wv2data/
.run-out.txt
.run-err.txt

# 运行期自检产物（t2h:ui_report 落盘）与本地调试截图
.lingqu/
.shot-*.png
.atomcode/
# hvigor（DevEco 打 HAP 时的构建缓存/日志：出现在工程根，属派生品）
.hvigor/
oh_modules/

# 打包产物（packaging/package-win.sh 的输出；含 DLL 与 zip，体积大且可复现）
dist/
